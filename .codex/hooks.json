{
  "description": "Security Check: first-stage terminal policy; review and trust via /hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|shell|shell_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"& 'C:/Program Files/Python311/python.exe' -X utf8 'C:/Users/mr.Sharkovich/Desktop/audio-masking-website/.codex/hooks/security_check.py'\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"& 'C:/Program Files/Python311/python.exe' -X utf8 'C:/Users/mr.Sharkovich/Desktop/audio-masking-website/.codex/hooks/security_check.py'\"",
            "timeout": 10,
            "statusMessage": "Security Check"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -Command \"& 'C:/Program Files/Python311/python.exe' -X utf8 'C:/Users/mr.Sharkovich/Desktop/audio-masking-website/.codex/hooks/dependency_guard.py'\"",
