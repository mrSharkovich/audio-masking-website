# Reference only: set these variables in PowerShell; no .env loader is used.
AUDIOMASK_MAX_FILE_BYTES=26214400
AUDIOMASK_MAX_DURATION_SECONDS=300
# Optional existing writable directory; default is the OS temporary directory.
AUDIOMASK_TEMP_DIRECTORY=
# Absolute local paths; blank paths keep inference unavailable.
AUDIOMASK_GIGAAM_PYTHON=
AUDIOMASK_GIGAAM_WEIGHTS=
AUDIOMASK_WHISPER_PYTHON=
AUDIOMASK_WHISPER_WEIGHTS=
AUDIOMASK_WORKER_TIMEOUT_SECONDS=120
AUDIOMASK_MAX_CONCURRENT_ASR=1
AUDIOMASK_MAX_WORKER_OUTPUT_BYTES=262144
AUDIOMASK_CPU_THREADS=4
